{
  "Serilog": {
	"MinimumLevel": "Verbose",
	"WriteTo": [
	  {
		"Name": "File",
		"Args": {
		  "path": "logs/bootmanager-.log",
		  "rollingInterval": "Day",
		  "retainedFileCountLimit": 14,
		  "fileSizeLimitBytes": 10485760,
		  "rollOnFileSizeLimit": true,
		  "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
		}
	  }
	]
  },
  "BootManager": {
	"PowerCountdownSeconds": 20,
	"CloseApplicationsGracePeriodSeconds": 10,
	"ProtectedProcessNamesWindows": [
	  "explorer",
	  "ApplicationFrameHost",
	  "ShellExperienceHost",
	  "StartMenuExperienceHost",
	  "SearchHost",
	  "SearchUI",
	  "TextInputHost",
	  "LockApp",
	  "SystemSettings"
	],
	"ProtectedProcessNamesUnix": [
	  "systemd",
	  "init",
	  "launchd",
	  "dbus-daemon",
	  "dbus-broker",
	  "dbus-run-session",
	  "pipewire",
	  "pipewire-pulse",
	  "wireplumber",
	  "pulseaudio",
	  "ssh-agent",
	  "gpg-agent",
	  "Xorg",
	  "Xwayland",
	  "gdm",
	  "gdm-session-worker",
	  "sddm",
	  "sddm-helper",
	  "lightdm",
	  "gnome-shell",
	  "gnome-session-binary",
	  "gnome-keyring-daemon",
	  "mutter",
	  "plasmashell",
	  "plasma_session",
	  "ksmserver",
	  "kwin_x11",
	  "kwin_wayland",
	  "xfce4-session",
	  "xfwm4",
	  "sway",
	  "Hyprland",
	  "i3",
	  "openbox",
	  "WindowServer",
	  "loginwindow",
	  "Dock",
	  "Finder",
	  "SystemUIServer",
	  "Spotlight"
	]
  }
}
