{
  "Serilog": {
	"MinimumLevel": "Verbose",
	"WriteTo": [
	  {
		"Name": "File",
		"Args": {
		  "path": "logs/bootmanager-.log",
		  "rollingInterval": "Day",
		  "retainedFileCountLimit": 14,
		  "fileSizeLimitBytes": 10485760,
		  "rollOnFileSizeLimit": true,
		  "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
		}
	  }
	]
  },
  "BootManager": {
	"PowerCountdownSeconds": 20,
	"CloseApplicationsGracePeriodSeconds": 10,
	"ProtectedProcessNamesWindows": [
	  "explorer",
	  "ApplicationFrameHost",
	  "ShellExperienceHost",
	  "StartMenuExperienceHost",
	  "SearchHost",
	  "SearchUI",
	  "TextInputHost",
	  "LockApp",
	  "SystemSettings"
	],
