# Indentation and line endings for every editor that opens this repository.
# VS Code applies these natively; no extension is required.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 4
tab_width = 4
insert_final_newline = true
trim_trailing_whitespace = true

# YAML forbids tabs as indentation, so these files stay on spaces.
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# In Markdown a leading tab starts a code block, and trailing spaces are a line break.
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
