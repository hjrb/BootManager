<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BootManager.Views.PowerCountdownWindow"
        Title="Delayed Reboot"
        Width="320"
        Height="170"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Delayed Reboot" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
        <TextBlock x:Name="CountdownText" Text="Rebooting in 20 seconds" FontSize="18" HorizontalAlignment="Center" />
        <Button x:Name="CancelButton" Content="Cancel" HorizontalAlignment="Center" Width="120" />
    </StackPanel>
</Window>
