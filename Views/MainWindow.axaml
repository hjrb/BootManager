<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:BootManager.ViewModels"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:conv="using:Avalonia.Data.Converters"
		xmlns:localConv="using:BootManager.Converters"
		mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="480"
		x:Class="BootManager.Views.MainWindow"
		x:DataType="vm:MainViewModel"
		Icon="/Assets/bootmanager.ico"
		Width="640" Height="480"
		Title="BootManager">

	<Design.DataContext>
		<!-- This only sets the DataContext for the previewer in an IDE,
			 to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
		<vm:MainViewModel />
	</Design.DataContext>

	<Window.Styles>
		<Style Selector="Border.current">
			<Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
			<Setter Property="BorderThickness" Value="2" />
		</Style>
		<Style Selector="TextBlock.tag">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="Padding" Value="6,2" />
			<Setter Property="Margin" Value="4,0,0,0" />
			<Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
			<Setter Property="Foreground" Value="White" />
		</Style>
		<Style Selector="WrapPanel > Button">
			<Setter Property="Margin" Value="8,4,0,0" />
		</Style>

		<!-- Zebra striping uses a translucent grey so it works in either system theme. -->
		<Style Selector="ItemsControl.infoRows ContentPresenter:nth-child(2n) > Border">
			<Setter Property="Background" Value="#18808080" />
		</Style>
		<Style Selector="SelectableTextBlock.infoLabel">
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="VerticalAlignment" Value="Top" />
		</Style>
		<Style Selector="SelectableTextBlock.infoValue">
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="VerticalAlignment" Value="Top" />
			<Setter Property="FontFamily" Value="{StaticResource ContentControlThemeFontFamily}" />
		</Style>
		<!-- The command line help is laid out with spaces, so it only lines up in a monospaced font.
			 The list is a fallback chain: the first family present on the system wins. -->
		<Style Selector="SelectableTextBlock.console">
			<Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace" />
			<Setter Property="FontSize" Value="13" />
		</Style>
	</Window.Styles>

	<Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12">
		<Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
			<TextBlock Grid.Column="0" Text="UEFI Boot Options" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
			<Button Grid.Column="1" Content="About" Click="OnAboutButtonClick" ToolTip.Tip="Version, licence and third-party notices." />
		</Grid>

		<Border Grid.Row="1" IsVisible="{Binding !IsElevated}"
				Background="Goldenrod" Padding="10" CornerRadius="4" Margin="0,0,0,8">
			<Grid ColumnDefinitions="*,Auto">
				<TextBlock Grid.Column="0" Text="{Binding ElevationMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
				<Button Grid.Column="1" Content="{Binding RestartElevatedLabel}" Command="{Binding RestartElevatedCommand}" />
			</Grid>
		</Border>

		<TabControl Grid.Row="2">
			<TabItem Header="Boot Options">
				<Grid RowDefinitions="*,Auto" Margin="0,8,0,0">
					<ListBox Grid.Row="0"
							 ItemsSource="{Binding BootEntries}"
							 SelectedItem="{Binding SelectedEntry}">
						<ListBox.ItemTemplate>
							<DataTemplate>
								<Border Padding="8" CornerRadius="4" Classes.current="{Binding IsCurrentDefault}">
									<StackPanel Orientation="Horizontal">
										<TextBlock Text="{Binding Description}" VerticalAlignment="Center" />
										<TextBlock Text="Current default" Classes="tag" IsVisible="{Binding IsCurrentDefault}" />
										<TextBlock Text="Next boot" Classes="tag" IsVisible="{Binding IsNextBoot}" />
									</StackPanel>
								</Border>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>

					<WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,8,0,0">
						<Button Content="Refresh" Command="{Binding RefreshCommand}" />
						<Button Content="Set as Next Boot" Command="{Binding ApplyNextBootCommand}" IsEnabled="{Binding SelectedEntry, Converter={x:Static conv:ObjectConverters.IsNotNull}}" ToolTip.Tip="One-time override: applies to the next boot only, then reverts to the default." />
						<Button Content="Set as Default" Command="{Binding ApplyDefaultBootCommand}" IsEnabled="{Binding SelectedEntry, Converter={x:Static conv:ObjectConverters.IsNotNull}}" ToolTip.Tip="Persistent: applies to every boot until changed again." />
						<Button Content="Open UEFI Setup at Next Boot" Command="{Binding ConfigureFirmwareSetupCommand}" />
						<Button x:Name="PowerButton" Content="Power" Click="OnPowerButtonClick" />
					</WrapPanel>
				</Grid>
			</TabItem>

			<TabItem Header="System Information">
				<Grid RowDefinitions="*,Auto" Margin="0,8,0,0">
					<ScrollViewer Grid.Row="0">
						<ItemsControl ItemsSource="{Binding SystemInfoGroups}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Expander Header="{Binding Category}" IsExpanded="True" Margin="0,0,0,4">
										<ItemsControl ItemsSource="{Binding Items}" Classes="infoRows">
											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<Border Padding="8,5">
														<Grid ColumnDefinitions="180,*">
															<SelectableTextBlock Grid.Column="0" Text="{Binding Label}" Classes="infoLabel" />
															<SelectableTextBlock Grid.Column="1" Text="{Binding Value}" Classes="infoValue" />
														</Grid>
													</Border>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</Expander>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>

					<WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,8,0,0">
						<Button Content="Refresh" Command="{Binding RefreshSystemInfoCommand}" />
						<Button Content="Copy All" Click="OnCopySystemInfo" ToolTip.Tip="Copies all values as text, ready to paste into a bug report." />
					</WrapPanel>
				</Grid>
			</TabItem>

			<TabItem Header="Command Line">
				<Grid RowDefinitions="Auto,*,Auto" Margin="0,8,0,0">
					<TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8"
							   Text="The same executable also works without a window. Started with one of these commands it prints its result to the console and exits, which makes it usable from scripts." />
					<ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto">
						<SelectableTextBlock Classes="console" Text="{Binding CommandLineHelpText}" Padding="4" />
					</ScrollViewer>
					<WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,8,0,0">
						<Button Content="Copy" Click="OnCopyCommandLineHelp" ToolTip.Tip="Copies the help text as shown by 'BootManager help'." />
					</WrapPanel>
				</Grid>
			</TabItem>
		</TabControl>

		<ProgressBar Grid.Row="3" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Margin="0,8,0,0" />

		<Border Grid.Row="0" Grid.RowSpan="4"
				VerticalAlignment="Bottom"
				Background="{Binding IsNotificationError, Converter={x:Static localConv:NotificationBrushConverter.Instance}}"
				IsVisible="{Binding NotificationMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
				Padding="10" Margin="0,0,0,48" CornerRadius="4">
			<Grid ColumnDefinitions="*,Auto,Auto">
				<ScrollViewer Grid.Column="0" MaxHeight="140" VerticalScrollBarVisibility="Auto">
					<SelectableTextBlock Text="{Binding NotificationMessage}" TextWrapping="Wrap" Foreground="White" />
				</ScrollViewer>
				<Button Grid.Column="1" Content="Copy" Click="OnCopyNotification" Background="Transparent" Foreground="White" VerticalAlignment="Top" />
				<Button Grid.Column="2" Content="✕" Command="{Binding DismissNotificationCommand}" Background="Transparent" Foreground="White" VerticalAlignment="Top" />
			</Grid>
		</Border>
	</Grid>

</Window>
