<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:BootManager.ViewModels"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:conv="using:Avalonia.Data.Converters"
		xmlns:localConv="using:BootManager.Converters"
		xmlns:models="using:BootManager.Models"
		mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="480"
		x:Class="BootManager.Views.MainWindow"
		x:DataType="vm:MainViewModel"
		Icon="/Assets/bootmanager.ico"
		Width="1280" Height="480"
		Title="BootManager">

	<Design.DataContext>
		<!-- This only sets the DataContext for the previewer in an IDE,
			 to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
		<vm:MainViewModel />
	</Design.DataContext>

	<Window.Styles>
		<Style Selector="Border.current">
			<Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
			<Setter Property="BorderThickness" Value="2" />
		</Style>
		<Style Selector="TextBlock.tag">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="Padding" Value="6,2" />
			<Setter Property="Margin" Value="4,0,0,0" />
			<Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
			<Setter Property="Foreground" Value="White" />
		</Style>
		<Style Selector="WrapPanel > Button">
			<Setter Property="Margin" Value="8,4,0,0" />
		</Style>

		<!-- Toolbar: one bar of captioned groups. The groups wrap as blocks, the buttons inside a
			 group wrap on their own, and the buttons are flat so the bar reads as a toolbar. -->
		<Style Selector="Border.toolbar">
			<Setter Property="Background" Value="#14808080" />
			<Setter Property="BorderBrush" Value="#30808080" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="6" />
			<Setter Property="Padding" Value="6,4" />
		</Style>
		<Style Selector="TextBlock.toolGroupHeader">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Opacity" Value="0.6" />
			<Setter Property="Margin" Value="4,0,0,2" />
		</Style>
		<Style Selector="Rectangle.toolSeparator">
			<Setter Property="Width" Value="1" />
			<Setter Property="Fill" Value="#30808080" />
			<Setter Property="Margin" Value="4,2,8,2" />
			<Setter Property="VerticalAlignment" Value="Stretch" />
		</Style>
		<Style Selector="Border.toolbar Button">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="10,5" />
			<Setter Property="Margin" Value="0,0,2,2" />
		</Style>

		<!-- Zebra striping uses a translucent grey so it works in either system theme. -->
		<Style Selector="ItemsControl.infoRows ContentPresenter:nth-child(2n) > Border">
			<Setter Property="Background" Value="#18808080" />
		</Style>
		<Style Selector="SelectableTextBlock.infoLabel">
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="VerticalAlignment" Value="Top" />
		</Style>
		<Style Selector="SelectableTextBlock.infoValue">
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="VerticalAlignment" Value="Top" />
			<Setter Property="FontFamily" Value="{StaticResource ContentControlThemeFontFamily}" />
		</Style>
		<!-- The command line help is laid out with spaces, so it only lines up in a monospaced font.
			 The list is a fallback chain: the first family present on the system wins. -->
		<Style Selector="SelectableTextBlock.console">
			<Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace" />
			<Setter Property="FontSize" Value="13" />
		</Style>
	</Window.Styles>

	<Grid RowDefinitions="Auto,*,Auto" Margin="12">
		<Border Grid.Row="0" IsVisible="{Binding !IsElevated}"
				Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
				BorderBrush="#30808080" BorderThickness="1"
				Padding="10" CornerRadius="4" Margin="0,0,0,8"
				ToolTip.Tip="Firmware variables can only be read and written with elevated privileges.">
			<Grid ColumnDefinitions="*,Auto">
				<TextBlock Grid.Column="0" Text="{Binding ElevationMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
				<Button Grid.Column="1" Content="{Binding RestartElevatedLabel}" Command="{Binding RestartElevatedCommand}"
						ToolTip.Tip="Starts the application again with elevated privileges and closes this instance." />
			</Grid>
		</Border>

		<TabControl Grid.Row="1">
			<TabItem Header="Boot Options" ToolTip.Tip="The boot entries the firmware offers, and the actions that change them.">
				<Grid RowDefinitions="Auto,*" Margin="0,8,0,0">
					<Border Grid.Row="0" Classes="toolbar" Margin="0,0,0,8">
						<WrapPanel>
							<StackPanel IsVisible="{Binding HasRebootActions}">
								<TextBlock Text="Reboot" Classes="toolGroupHeader" />
								<ItemsControl ItemsSource="{Binding RebootActions}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<WrapPanel />
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="models:PowerActionItem">
											<Button Content="{Binding Label}" ToolTip.Tip="{Binding Tooltip}" Click="OnPowerActionClick" />
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>

							<Rectangle Classes="toolSeparator" IsVisible="{Binding HasSleepActions}" />
							<StackPanel IsVisible="{Binding HasSleepActions}">
								<TextBlock Text="Sleep" Classes="toolGroupHeader" />
								<ItemsControl ItemsSource="{Binding SleepActions}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<WrapPanel />
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="models:PowerActionItem">
											<Button Content="{Binding Label}" ToolTip.Tip="{Binding Tooltip}" Click="OnPowerActionClick" />
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>

							<Rectangle Classes="toolSeparator" IsVisible="{Binding HasShutdownActions}" />
							<StackPanel IsVisible="{Binding HasShutdownActions}">
								<TextBlock Text="Shutdown" Classes="toolGroupHeader" />
								<ItemsControl ItemsSource="{Binding ShutdownActions}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<WrapPanel />
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="models:PowerActionItem">
											<Button Content="{Binding Label}" ToolTip.Tip="{Binding Tooltip}" Click="OnPowerActionClick" />
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>

							<Rectangle Classes="toolSeparator" IsVisible="{Binding HasPowerActions}" />
							<StackPanel>
								<TextBlock Text="UEFI" Classes="toolGroupHeader" />
								<WrapPanel>
									<Button Content="Refresh" Command="{Binding RefreshCommand}" ToolTip.Tip="{Binding RefreshTooltip}" />
									<Button Content="Next Boot" Command="{Binding ApplyNextBootCommand}" IsEnabled="{Binding SelectedEntry, Converter={x:Static conv:ObjectConverters.IsNotNull}}" ToolTip.Tip="{Binding NextBootTooltip}" />
									<Button Content="Default" Command="{Binding ApplyDefaultBootCommand}" IsEnabled="{Binding SelectedEntry, Converter={x:Static conv:ObjectConverters.IsNotNull}}" ToolTip.Tip="{Binding DefaultBootTooltip}" />
									<Button Content="UEFI Setup" Click="OnFirmwareSetupButtonClick" IsEnabled="{Binding IsElevated}" ToolTip.Tip="{Binding FirmwareSetupTooltip}" />
								</WrapPanel>
							</StackPanel>

							<Rectangle Classes="toolSeparator" />
							<StackPanel>
								<TextBlock Text="Information" Classes="toolGroupHeader" />
								<WrapPanel>
									<Button Content="?" FontWeight="Bold" Click="OnBootEntryHelpClick"
											ToolTip.Tip="Not everything visible? Click here..." />
									<Button Content="About" Click="OnAboutButtonClick" ToolTip.Tip="Version, license and third-party notices." />
								</WrapPanel>
							</StackPanel>
						</WrapPanel>
					</Border>

					<ListBox Grid.Row="1"
							 ItemsSource="{Binding BootEntries}"
							 SelectedItem="{Binding SelectedEntry}"
							 ToolTip.Tip="Boot entries in firmware boot order. Select one, then use the buttons in the toolbar above.&#x0a;Removable media only appear when they were attached while the machine powered on.">
						<ListBox.ItemTemplate>
							<DataTemplate>
								<Border Padding="8" CornerRadius="4" Classes.current="{Binding IsCurrentDefault}"
										ToolTip.Tip="{Binding Id, StringFormat='Firmware boot entry {0}'}">
									<StackPanel Orientation="Horizontal">
										<TextBlock Text="{Binding Description}" VerticalAlignment="Center" />
										<TextBlock Text="Current default" Classes="tag" IsVisible="{Binding IsCurrentDefault}"
												   ToolTip.Tip="First in BootOrder: the entry used on every boot." />
										<TextBlock Text="Next boot" Classes="tag" IsVisible="{Binding IsNextBoot}"
												   ToolTip.Tip="Set in BootNext: used once on the next boot, then cleared by the firmware." />
									</StackPanel>
								</Border>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</Grid>
			</TabItem>

			<TabItem Header="System Information" ToolTip.Tip="Firmware, platform and disk facts collected from this machine.">
				<Grid RowDefinitions="*,Auto" Margin="0,8,0,0">
					<ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled">
						<ItemsControl ItemsSource="{Binding SystemInfoGroups}" HorizontalAlignment="Stretch">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Expander Header="{Binding Category}" IsExpanded="True" Margin="0,0,0,4"
											  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
											  ToolTip.Tip="Click to collapse or expand this category.">
										<ItemsControl ItemsSource="{Binding Items}" Classes="infoRows" HorizontalAlignment="Stretch">
											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<Border Padding="8,5" ToolTip.Tip="{Binding Value}">
														<Grid ColumnDefinitions="180,*">
															<SelectableTextBlock Grid.Column="0" Text="{Binding Label}" Classes="infoLabel" />
															<SelectableTextBlock Grid.Column="1" Text="{Binding Value}" Classes="infoValue" />
														</Grid>
													</Border>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</Expander>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>

					<WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,8,0,0">
						<Button Content="Refresh" Command="{Binding RefreshSystemInfoCommand}" ToolTip.Tip="Collects the diagnostic values again." />
						<Button Content="Copy All" Click="OnCopySystemInfo" ToolTip.Tip="Copies all values as text, ready to paste into a bug report." />
					</WrapPanel>
				</Grid>
			</TabItem>

			<TabItem Header="Command Line" ToolTip.Tip="How to drive this application from a script or terminal.">
				<Grid RowDefinitions="Auto,*,Auto" Margin="0,8,0,0">
					<TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8"
							   Text="The same executable also works without a window. Started with one of these commands it prints its result to the console and exits, which makes it usable from scripts." />
					<ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto">
						<SelectableTextBlock Classes="console" Text="{Binding CommandLineHelpText}" Padding="4"
											 ToolTip.Tip="Select any part of this text to copy it directly." />
					</ScrollViewer>
					<WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,8,0,0">
						<Button Content="Copy" Click="OnCopyCommandLineHelp" ToolTip.Tip="Copies the help text as shown by 'BootManager help'." />
					</WrapPanel>
				</Grid>
			</TabItem>
		</TabControl>

		<ProgressBar Grid.Row="2" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Margin="0,8,0,0"
					 ToolTip.Tip="An operation is running." />

		<Border Grid.Row="0" Grid.RowSpan="3"
				VerticalAlignment="Bottom"
				Background="{Binding IsNotificationError, Converter={x:Static localConv:NotificationBrushConverter.Instance}}"
				IsVisible="{Binding NotificationMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
				Padding="10" Margin="0,0,0,48" CornerRadius="4">
			<Grid ColumnDefinitions="*,Auto,Auto">
				<ScrollViewer Grid.Column="0" MaxHeight="140" VerticalScrollBarVisibility="Auto">
					<SelectableTextBlock Text="{Binding NotificationMessage}" TextWrapping="Wrap" Foreground="White"
										 ToolTip.Tip="Result of the last operation. The text can be selected and copied." />
				</ScrollViewer>
				<Button Grid.Column="1" Content="Copy" Click="OnCopyNotification" Background="Transparent" Foreground="White" VerticalAlignment="Top"
						ToolTip.Tip="Copies this message to the clipboard." />
				<Button Grid.Column="2" Content="✕" Command="{Binding DismissNotificationCommand}" Background="Transparent" Foreground="White" VerticalAlignment="Top"
						ToolTip.Tip="Hides this message." />
			</Grid>
		</Border>
	</Grid>

</Window>
