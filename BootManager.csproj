<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	<!-- GUI subsystem: a console subsystem process makes Windows create a console window whenever it
		 is started without one, and since Windows 11 hosts that console in a separate terminal
		 application, the window can no longer be hidden away by the process itself. In CLI mode
		 CommandLineInterface.AttachToParentConsole writes into the caller's console instead. -->
	<OutputType>WinExe</OutputType>
	<TargetFramework>net10.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<ApplicationManifest>app.manifest</ApplicationManifest>
	<!-- Icon compiled into the Windows executable, so Explorer and the taskbar show it as well. -->
	<ApplicationIcon>Assets\bootmanager.ico</ApplicationIcon>

	<!-- Read back at runtime by AppInfo for the About window. The release workflow overrides
		 Version with the git tag; this value is the fallback for local builds. -->
	<Product>BootManager</Product>
	<Version>1.1.0</Version>
	<Copyright>Copyright 2026 BootManager contributors</Copyright>
  </PropertyGroup>

  <ItemGroup>
	<AvaloniaResource Include="Assets\**" />
	<None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
	<!-- Licence documents are part of the deliverable: the Apache-2.0 licence of this program and
		 the notices for the third-party packages it redistributes. The About window links to the
		 copies that end up next to the executable. -->
	<None Include="LICENSE" CopyToOutputDirectory="PreserveNewest" />
	<None Include="NOTICE" CopyToOutputDirectory="PreserveNewest" />
	<None Include="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="Avalonia" Version="12.1.4" />
	<PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
	<PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
	<PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
	<PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
	  <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
	  <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
	</PackageReference>
	<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
	<PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
	<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
	<PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="10.0.12" />
	<PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.12" />
	<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
	<PackageReference Include="Serilog" Version="4.4.0" />
	<PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
	<PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
	<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
</Project>
